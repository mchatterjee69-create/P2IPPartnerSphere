# P2IP PartnerSphere™ - Environment Configuration
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# Production Mode: When false, all fake and demo data is wiped.
# Partners = 0, Referrals = 0, Customers = 0, Revenue = ₹0, Commission = ₹0, Payouts = ₹0
NODE_ENV=production
DEMO_MODE=false

# Razorpay / RazorpayX Payouts Configuration (Optional)
# If unconfigured, the system automatically uses Mode A: Manual UPI / Google Pay / Bank Transfer with UTR audit logging.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAYX_ACCOUNT_ID=
RAZORPAY_WEBHOOK_SECRET=
